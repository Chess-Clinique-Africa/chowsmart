# Server
PORT=4000
# Use Docker Postgres:
# DATABASE_URL=postgresql://chowsmart:chowsmart@localhost:5432/chowsmart
# Or embedded Postgres (no Docker required):
DATABASE_URL=pglite
USE_PGLITE=true
CLIENT_ORIGIN=http://localhost:5173

# Client (Vite) — leave as /api when using the Vite proxy
VITE_API_URL=/api
